{
  "name": "shortcut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-transform-types --test tests/*.test.ts",
    "qr": "node tools/make-qr.mjs",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
